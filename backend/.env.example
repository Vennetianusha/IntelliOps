PROJECT_NAME="IntelliOps API"
VERSION="0.1.0"
API_V1_STR="/api/v1"
PORT=8000
HOST="0.0.0.0"
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=intelliops
# Optional explicit override for DATABASE_URL (if unset, computed automatically)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/intelliops

# Redis Cache Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CACHE_TTL_SECONDS=300

# AI Analysis Configuration
GEMINI_API_KEY=
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash



